---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Dagger Development',
  url: 'https://daggerdev.com/',
  founder: { '@type': 'Person', name: 'James Shelby' },
  email: 'mailto:daggerdevelop@gmail.com',
  description: 'An independent iOS development studio creating focused apps and games for everyday life.',
  sameAs: ['https://apps.apple.com/us/developer/james-shelby/id1848027565'],
};

const featured = apps[0];
---
<BaseLayout
  title="Dagger Development — Independent iOS Apps"
  description="Dagger Development is the independent iOS studio of James Shelby, creating focused apps and games for everyday life."
  canonicalPath="/"
  image="/dagger_logo.png"
  imageAlt="Dagger Development logo"
  structuredData={organizationSchema}
>
  <section class="hero" id="top">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Independent iOS studio</p>
        <h1>Useful apps.<br><em>Forged with focus.</em></h1>
        <p class="hero-lede">Dagger Development is the independent studio of James Shelby—building clear, purposeful iOS apps and games for everyday life.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/apps/">Explore the apps <span aria-hidden="true">→</span></a>
          <a class="button button-quiet" href="https://apps.apple.com/us/developer/james-shelby/id1848027565">Developer page <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <a class="featured-app" href={`/apps/${featured.slug}/`} aria-label={`Learn about ${featured.shortName}`}>
        <div class="featured-topline">
          <span>Featured app</span>
          <span>{featured.category} · Free</span>
        </div>
        <div class="featured-body">
          <img src={featured.icon} alt={`${featured.shortName} app icon`} width="512" height="512" fetchpriority="high" />
          <div>
            <h2>{featured.shortName}</h2>
            <p>Organize bills by paycheck and see what’s left without linking a bank.</p>
          </div>
        </div>
        <div class="featured-footer">
          <span>Read the app guide</span>
          <span class="arrow" aria-hidden="true">→</span>
        </div>
      </a>
    </div>
    <div class="hero-rule" aria-hidden="true"><span>FORGED IN CODE</span></div>
  </section>

  <section class="apps-section section" id="apps">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow"><span></span> In-app purchase releases</p>
        <h2>Start with the job.<br>Meet the app.</h2>
        <p>Detailed guides for the current DaggerDev apps that offer optional in-app purchases, built to help you decide before opening the App Store.</p>
      </div>

      <div class="app-list">
        {apps.map((app, index) => (
          <a class="app-row" href={`/apps/${app.slug}/`}>
            <span class="app-index">{String(index + 1).padStart(2, '0')}</span>
            <img src={app.icon} alt={`${app.shortName} icon`} width="512" height="512" loading="lazy" />
            <span class="app-details"><strong>{app.shortName}</strong><small>{app.subtitle}</small></span>
            <span class="app-meta">{app.category} · Free download</span>
            <span class="app-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/apps/">Open the app directory <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="story-section section" id="story">
    <div class="shell story-grid">
      <div class="story-mark" aria-hidden="true">
        <svg viewBox="0 0 180 260">
          <path d="M90 8v34M25 62h130M90 76L76 172M58 105l-38 28 38 28M122 105l38 28-38 28M90 190v62" />
        </svg>
      </div>
      <div class="story-copy">
        <p class="eyebrow"><span></span> The maker behind the mark</p>
        <h2>Craft learned in the real world. Applied in code.</h2>
        <p class="story-lede">I’m James Shelby, an independent iOS developer from Salem, Oregon.</p>
        <p>My path to software ran through emergency medical work, private security, and more than seven years in knife manufacturing. Each taught me the same lesson: details matter, dependable tools earn trust, and good work should have a clear purpose.</p>
        <p>Dagger Development brings that mindset to software—focused products, thoughtful interfaces, and steady improvement with every release.</p>
        <a class="text-link" href="mailto:daggerdevelop@gmail.com">Start a conversation <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="principles-section section" id="principles">
    <div class="shell">
      <div class="section-heading compact">
        <p class="eyebrow"><span></span> How I build</p>
        <h2>Purpose before complexity.</h2>
      </div>
      <div class="principles-grid">
        <article><span>01 / Focus</span><h3>Do one job well.</h3><p>Every app starts with a clear problem and stays centered on solving it.</p></article>
        <article><span>02 / Craft</span><h3>Details earn trust.</h3><p>Typography, interaction, privacy, and performance are part of the product—not polish added later.</p></article>
        <article><span>03 / Progress</span><h3>Ship, listen, improve.</h3><p>Useful software is shaped over time through real use and honest feedback.</p></article>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="shell contact-grid">
      <div><p class="eyebrow"><span></span> Support &amp; feedback</p><h2>Have a question or an idea?</h2></div>
      <div><p>Whether you need support for an app or want to share feedback, I’d like to hear from you.</p><a class="button button-light" href="mailto:daggerdevelop@gmail.com">daggerdevelop@gmail.com <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
